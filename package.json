{
  "name": "askcalls-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/adapters/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@askcalls/web",
    "build": "turbo run build",
    "check": "bun run lint && bun run typecheck && bun run boundaries && bun run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "test": "bun --bun vitest run --project unit",
    "test:integration": "bun --bun vitest run --project integration",
    "test:e2e": "bun run --cwd apps/web test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.7.2",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
