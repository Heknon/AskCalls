{
  "name": "askcalls-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/adapters/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@askcalls/web",
    "build": "turbo run build",
    "check": "bun run lint && bun run typecheck && bun run boundaries && bun run test",
    "check:bundle": "bun run --cwd apps/web build && bun run budget",
    "budget": "bun scripts/checks/bundle-budget.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs",
    "test": "bun --bun vitest run --project unit",
    "test:integration": "bun --bun vitest run --project integration",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "test:e2e:local": "bun run --cwd apps/web test:e2e:local",
    "release:hashes": "bun scripts/release/client-hashes.ts",
    "release:dry-run": "bun scripts/release/dry-run.ts",
    "models:derive": "bun scripts/models/derive-keep-set.ts",
    "models:build": "bun scripts/models/build-e5.ts",
    "models:publish": "bun scripts/models/publish.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.7.2",
    "neonctl": "9.3.2",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "vercel": "65.8.0",
    "vitest": "5.1.0"
  }
}
