# AskCalls configuration. Every variable is optional except where noted.
# A variable set here locks its setting: /admin/instance shows it read-only.
# Anything not set can be configured in the first-run wizard and /admin/instance.

# --- Instance ---
APP_URL=http://localhost:3000
APP_MODE=server                    # server | local
ASKCALLS_LOCAL_KEY=                # local mode only; `askcalls local` sets it on every start, never set by hand
ASKCALLS_LOCAL_AGENT_LINK_URL=     # local mode only; set by `askcalls local` while the agent is unlinked
ASKCALLS_HOSTED=false              # true only on askcalls.com: locks instance config, hides the offline toggle
ASKCALLS_DATA_DIR=                 # config.json, PGlite data and fs blobs. Default ./data (server), ~/.askcalls (local)
OFFLINE_MODE=false                 # true = air-gapped: refuse any non-local URL

# --- Sign-in (Auth.js) ---
AUTH_SECRET=                       # required in production: openssl rand -base64 32
AUTH_PROVIDERS=google              # comma list: google,github,email
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_LOCAL_ACCOUNTS=false          # email + passkey/password accounts; required when OFFLINE_MODE=true

# --- Database ---
DB_DRIVER=postgres                 # postgres | pglite
DATABASE_URL=                      # postgres only, e.g. postgres://user:pass@host:5432/askcalls
PGLITE_DATA_DIR=~/.askcalls/db     # pglite only
DB_MIGRATE_ON_BOOT=false           # postgres: migrate when the server starts (Docker self-host); pglite always does

# --- Blob storage (encrypted recordings, large inbox payloads) ---
BLOB_DRIVER=s3                     # s3 | fs
S3_ENDPOINT=                       # unset for AWS S3 (askcalls.com); R2, MinIO, Backblaze B2: their S3 endpoint
S3_REGION=                         # AWS: the bucket's region (required, e.g. eu-central-1); default auto with an endpoint
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=                     # prefix for every object key, e.g. preview/pr-12/ (previews share the dev bucket)
FS_BLOB_DIR=./data/blobs
ALLOW_USER_BUCKETS=true            # users may set their own S3-compatible bucket

# --- Transcription ---
TRANSCRIPTION_PROVIDER=elevenlabs  # elevenlabs | openai | deepgram | soniox | openai-compatible | mock | none
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
SONIOX_API_KEY=
TRANSCRIPTION_BASE_URL=            # OpenAI-compatible speech server, e.g. a local Whisper server
ALLOW_BYO_TRANSCRIPTION_KEY=true   # users may store their own provider key (encrypted on their device)

# --- Ask about a call (LLM) ---
LLM_PROVIDER=anthropic             # any AI SDK provider id, or mock | none
LLM_MODEL=
ANTHROPIC_API_KEY=
LLM_BASE_URL=                      # OpenAI-compatible server, e.g. Ollama or vLLM
LLM_TRANSLATION=true               # translate every call to English and Hebrew at ingest (/api/translate)

# --- Indexing and limits ---
EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_MODEL_URL=               # model host for browsers, e.g. https://models.askcalls.com (askcalls.com: CloudFront; files under e5-pruned/<build>/,
                                   # see scripts/models/README.md). Default: this app's /models/. Ignored when OFFLINE_MODE=true
FREE_TIER_MAX_CALLS=500

# --- Telemetry (off by default, content-free) ---
TELEMETRY=none                     # comma list: otel,sentry,posthog,umami
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
SENTRY_DSN=                        # Sentry or GlitchTip
POSTHOG_KEY=
POSTHOG_HOST=
UMAMI_WEBSITE_ID=
UMAMI_HOST=

# --- Billing ---
BILLING_PROVIDER=none

# --- Jobs ---
SCHEDULER=                         # vercel-cron | in-process (default: vercel-cron on Vercel, in-process elsewhere)
CRON_SECRET=                       # required in production for /api/cron/*
