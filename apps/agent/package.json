{
  "name": "askcalls",
  "version": "0.0.0",
  "description": "AskCalls agent: local MCP server, bulk ingest, device linking and local mode",
  "license": "MIT",
  "type": "module",
  "bin": {
    "askcalls": "./src/cli.ts"
  },
  "files": [
    "src",
    "web"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "package:web": "bun ../../scripts/package-local-web.ts",
    "prepack": "bun run --cwd ../web build && bun ../../scripts/package-local-web.ts",
    "build:binary": "bun ../../scripts/build-agent-binary.ts"
  },
  "dependencies": {
    "@askcalls/adapter-llm-ai-sdk": "workspace:*",
    "@askcalls/adapter-transcription-deepgram": "workspace:*",
    "@askcalls/adapter-transcription-elevenlabs": "workspace:*",
    "@askcalls/adapter-transcription-openai": "workspace:*",
    "@askcalls/adapter-transcription-openai-compatible": "workspace:*",
    "@askcalls/adapter-transcription-soniox": "workspace:*",
    "@askcalls/api-contract": "workspace:*",
    "@askcalls/client-core": "workspace:*",
    "@askcalls/crypto": "workspace:*",
    "@askcalls/domain": "workspace:*",
    "@askcalls/transcript-formats": "workspace:*",
    "@huggingface/transformers": "4.3.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/keyring": "2.1.2",
    "commander": "15.1.0",
    "ffmpeg-static": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vitest": "5.1.0"
  }
}
